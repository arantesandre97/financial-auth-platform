# ============================================================
# financial-auth-platform — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env — ele está no .gitignore.
# ============================================================

# LocalStack — obrigatório para subir o container com autenticação
# Obtenha em: https://app.localstack.cloud/account/apikeys
LOCALSTACK_AUTH_TOKEN=ls-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# PostgreSQL (usado pelo Spring quando profile != local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/financialauth
SPRING_DATASOURCE_USERNAME=fap
SPRING_DATASOURCE_PASSWORD=fap_secret

# Redis (usado pelo Spring quando profile != local)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# AWS (LocalStack emula localmente)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566